{
  "description": "ADFlow settings for the fictitious corp.example.com lab domain. Copy and adapt for your own directory.",
  "domain": {
    "upnSuffix": "corp.example.com",
    "mailDomain": "corp.example.com"
  },
  "naming": {
    "maxLength": 20
  },
  "password": {
    "length": 16
  },
  "defaultGroups": [
    "GG-AllStaff"
  ],
  "departments": {
    "IT": { "ou": "OU=IT,OU=Staff,DC=corp,DC=example,DC=com" },
    "Finance": { "ou": "OU=Finance,OU=Staff,DC=corp,DC=example,DC=com" },
    "Human Resources": { "ou": "OU=Human Resources,OU=Staff,DC=corp,DC=example,DC=com" },
    "Sales": { "ou": "OU=Sales,OU=Staff,DC=corp,DC=example,DC=com" },
    "Marketing": { "ou": "OU=Marketing,OU=Staff,DC=corp,DC=example,DC=com" }
  },
  "roles": {
    "Helpdesk Technician": [ "GG-IT-Helpdesk", "GG-VPN-Users" ],
    "Systems Administrator": [ "GG-IT-Admins", "GG-VPN-Users" ],
    "Accountant": [ "GG-Finance-Users", "GG-ERP-Users" ],
    "Sales Representative": [ "GG-Sales-Users", "GG-CRM-Users", "GG-VPN-Users" ],
    "HR Specialist": [ "GG-HR-Users" ],
    "Marketing Specialist": [ "GG-Marketing-Users" ]
  },
  "offboarding": {
    "ou": "OU=Leavers,DC=corp,DC=example,DC=com"
  }
}
